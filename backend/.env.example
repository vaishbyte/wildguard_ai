# Sundarbans National Park (India) - monitoring area
CENTER_LAT=21.9497
CENTER_LON=88.8958
RADIUS_KM=25

# Location of your webcam/mic "field station" (shown on map)
STATION_LAT=21.9600
STATION_LON=88.8800

# Firebase Local Emulator
FIREBASE_PROJECT_ID=demo-wildguard
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional: real tree-cover-loss data (free key from https://data-api.globalforestwatch.org)
GFW_API_KEY=

# Detection settings
ENABLE_CAMERA=1
ENABLE_MIC=1
CAMERA_INDEX=0
YOLO_MODEL=yolov8n.pt
VISION_CONFIDENCE=0.45
AUDIO_THRESHOLD=0.25
ALERT_COOLDOWN_SEC=10
